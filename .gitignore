# =====================================
# Root project ignore rules
# =====================================

# Dependency directories
node_modules/
**/node_modules/

# Frontend build output
/dist/
/build/
/coverage/
.vite/
**/dist/
**/build/
**/coverage/
**/.vite/

# Environment files and secrets
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# OS files
.DS_Store
Thumbs.db
Desktop.ini

# Editor and IDE files
.vscode/
.idea/
*.swp
*.swo
*.tmp

# Local database / runtime artifacts
*.sqlite
*.db
*.pid

# Optional local uploads or storage directories
uploads/
storage/
public/uploads/

# Cache and temporary files
.cache/
.tmp/
*.tsbuildinfo
